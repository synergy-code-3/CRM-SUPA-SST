SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Secreto para firmar las sesiones (JWT) del login propio del CRM. Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

KAJABI_CLIENT_ID=
KAJABI_CLIENT_SECRET=
KAJABI_WEBHOOK_SECRET=
KAJABI_WEBHOOK_BASE_URL=

SKOOL_WEBHOOK_URL=

CRON_SECRET=

GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
GHL_TAG_ALTA_CRM=
# Secreto del webhook de confirmación de entrega (ver src/app/api/webhooks/ghl-bienvenida-wa)
GHL_WEBHOOK_SECRET=

HOTMART_WEBHOOK_SECRET=

# Bearer token para consultar el CRM de "Soporte/VSL" (otra área) — pestaña
# "Historial de compras" del perfil del cliente. Solo lectura de su lado.
VSL_SOPORTE_API_TOKEN=

# Bearer token para consultar "Synergy Axis" — el CRM con el histórico
# completo de todos los clientes (primer contacto, eventos, compras,
# estado de Synergy Unlimited). Pestaña "Historial" del perfil del
# cliente. Solo lectura de su lado.
AXIS_API_TOKEN=

# Bearer token que synergy-axis usa para consultar ESTE CRM (dirección
# opuesta a AXIS_API_TOKEN) — ver GET /api/internal/su26-cuota. Token
# propio y dedicado, no reusar AXIS_API_TOKEN.
SU26_QUOTA_API_TOKEN=
